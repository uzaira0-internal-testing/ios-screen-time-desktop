{
  "productName": "iOS Screen Time Screenshot Processor",
  "version": "0.6.4",
  "identifier": "com.ios-screentime.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "iOS Screen Time Screenshot Processor",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "visible": false,
        "backgroundColor": "#ffffff",
        "allowLinkPreview": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost pipeline: http://pipeline.localhost; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwMUIyOUJENjNDNEYzNjQKUldSazg4Ump2U2tiWUh3em1kU205cXlWMmp6MkNOOXE4N1BQVytWSVJSb0lDNk9xbE5kbnZVK1oK",
      "endpoints": [
        "https://github.com/uzaira0-internal-testing/ios-screen-time-desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "publisher": "Uzair Alam",
    "copyright": "© 2026 Uzair Alam",
    "category": "Productivity",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/uzaira0-internal-testing/ios-screen-time-desktop",
    "shortDescription": "Reads hourly usage from iOS Screen Time and Battery screenshots",
    "longDescription": "Reads iOS Screen Time and Battery screenshots into 24 hourly values, with review and correction, and exports them as CSV or JSON. Screenshots are processed on this computer and are never uploaded.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  }
}
