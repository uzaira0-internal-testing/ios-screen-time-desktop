{
  "productName": "iOS Screen Time",
  "version": "0.5.1",
  "identifier": "com.ios-screentime.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "iOS Screen Time",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost pipeline: http://pipeline.localhost; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGODdCNDc5NTkwQzAxMjUKUldRbEFReFplYlNIajlaaFhBY3pScjNtNmtHZWMxS2thNDdUWDRLc3lFSzVzOGo0MFVwb1BOSGsK",
      "endpoints": [
        "https://github.com/uzaira0-internal-testing/ios-screen-time-desktop/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
